diff --git a/net/core/dev.c b/net/core/dev.c
index f660fccfc..0d404fdd3 100644
--- a/net/core/dev.c
+++ b/net/core/dev.c
@@ -88,6 +88,8 @@
 #include <linux/sockios.h>
 #include <linux/errno.h>
 #include <linux/interrupt.h>
+#include <linux/topology.h>
+#include <linux/irq.h>
 #include <linux/if_ether.h>
 #include <linux/netdevice.h>
 #include <linux/etherdevice.h>
@@ -1670,6 +1672,7 @@ static int napi_threaded_poll(void *data);
 static int napi_kthread_create(struct napi_struct *n)
 {
 	int err = 0;
+	const struct cpumask *aff, *llc;
 
 	/* Create and wake up the kthread once to put it in
 	 * TASK_INTERRUPTIBLE mode to avoid the blocked task
@@ -1681,6 +1684,24 @@ static int napi_kthread_create(struct napi_struct *n)
 		err = PTR_ERR(n->thread);
 		pr_err("kthread_run failed with err %d\n", err);
 		n->thread = NULL;
+	} else if (n->irq > 0) {
+		/* Default the threaded poller's cpumask to the L3 (cluster)
+		 * siblings of its vector's effective affinity. A floating
+		 * poller lands on remote L3/NUMA cpus and stalls under
+		 * sustained flood (the measured placement asymmetry).
+		 * Re-applied on every thread (re)creation because a
+		 * driver reset destroys the thread -- the threaded-NAPI
+		 * lifecycle gap discussed upstream (June 2026 RFC). Only
+		 * the single-cpu effective-affinity case (per-channel MSI-X
+		 * vectors) gets the default; the spread case is left
+		 * floating. A later userspace set-affinity wins as usual.
+		 * topology_cluster_cpumask() is the CCX/L3 group on AMD.
+		 */
+		aff = irq_get_effective_affinity_mask(n->irq);
+		if (aff && cpumask_weight(aff) == 1) {
+			llc = topology_cluster_cpumask(cpumask_first(aff));
+			set_cpus_allowed_ptr(n->thread, llc);
+		}
 	}
 
 	return err;
@@ -7497,6 +7518,27 @@ void netif_napi_set_irq_locked(struct napi_struct *napi, int irq)
 		irq_set_affinity_notifier(napi->irq, NULL);
 
 	napi->irq = irq;
+	if (irq > 0 && napi->thread) {
+		/* T1E default: the poller's cpumask = the L3 (cluster)
+		 * siblings of the vector's effective affinity. A floating
+		 * poller lands on remote L3/NUMA cpus and stalls under
+		 * sustained flood (the measured placement asymmetry).
+		 * Applied at irq-assignment AND at thread (re)creation so
+		 * either driver order gets it; a driver reset destroys the
+		 * thread -- the threaded-NAPI lifecycle gap discussed
+		 * upstream (June 2026 RFC). Only the single-cpu
+		 * effective-affinity case gets the default. A later
+		 * userspace set-affinity wins as usual.
+		 * topology_cluster_cpumask() = the CCX/L3 group on AMD.
+		 */
+		const struct cpumask *t1e_aff =
+			irq_get_effective_affinity_mask(irq);
+
+		if (t1e_aff && cpumask_weight(t1e_aff) == 1)
+			set_cpus_allowed_ptr(napi->thread,
+					     topology_cluster_cpumask(
+						     cpumask_first(t1e_aff)));
+	}
 	if (irq < 0 ||
 	    (!napi->dev->rx_cpu_rmap_auto && !napi->dev->irq_affinity_auto))
 		return;
